# =============================================================================
# Unity generated (絶対に追跡しない)
# =============================================================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Crashlytics generated file
crashlytics-build.properties

# =============================================================================
# Visual Studio / Rider / IDE 自動生成
# =============================================================================
.vs/
.vscode/
.idea/
.vsconfig
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# =============================================================================
# このプロジェクト固有のビルド成果物 / バックアップ
# =============================================================================
# Android ビルド成果物
*.apk
*.aab

# Unity が吐く Burst デバッグ情報 / ビルド副産物
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# =============================================================================
# OS 固有
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =============================================================================
# Claude Code / AI エージェント関連（公開リポでは一旦すべて除外）
# =============================================================================
# Claude Code のローカル設定／hooks／agents／skills 一式
.claude/
# Codex / Claude 用のリポ内ガイド（個人パスや運用メモを含む可能性があるため）
AGENTS.md
CLAUDE.md
# Unity Editor 用 tmp / claude セッション一時領域
.utmp/

# Agent skills の実体・ロックファイルとも公開リポでは追跡しない．
# ローカル復元は `npx skills experimental_install` で行う．
.agents/
skills-lock.json

# =============================================================================
# Mono / Unity Editor のクラッシュダンプ（ローカル限定，公開不要）
# =============================================================================
mono_crash.*

# =============================================================================
# Unity がたまにプロジェクトルートに残す一時 DLL
# （Assets/Plugins/ 配下の DLL は追跡したいのでルート限定で指定）
# =============================================================================
/TempAssembly.dll

# =============================================================================
# CAD 投影用モデル本体は追跡しない（環境固有 / 機密 / 容量大）．
# Import 設定（*.fbx.meta 等）は !/Assets/**/*.meta の例外ルールで共有される．
# clone 後は Fusion からエクスポートした FBX を Assets/Models/ に配置すること．
# =============================================================================
/[Aa]ssets/[Mm]odels/*.fbx
/[Aa]ssets/[Mm]odels/*.obj
/[Aa]ssets/[Mm]odels/*.stl
/[Aa]ssets/[Mm]odels/*.blend
/[Aa]ssets/[Mm]odels/*.dae
/[Aa]ssets/[Mm]odels/*.3ds

# =============================================================================
# Unity Editor が自動保存する Scene 回復スナップショット
# =============================================================================
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# =============================================================================
# プロジェクトドキュメント（main ブランチでは載せない方針）
# - 必要になったら専用ブランチに切り替えてこのルールを外す
# - 引き継ぎメモも同様（外には出さない一次情報）
# =============================================================================
/docs/
/unity_metaquest_mr_cad_handover.txt

# =============================================================================
# ローカル環境変数 / 秘密情報
# =============================================================================
.env
.env.local
# ルート直下の *.local のみ対象（Assets/ 配下の .local 拡張子を巻き込まない）
/*.local
